# Main football API. Optional because the app has a safe default URL.
FOOTGLOBE_API_URL=https://footglobe-api-nu.vercel.app

# Optional broadcast lookup override. The app can fall back to TheSportsDB's public key.
SPORTSDB_API_KEY=

# Optional video highlights.
YOUTUBE_API_KEY=

# Optional Pix donations (Brazil).
GOATPAY_API_KEY=

# Optional crypto donations.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional production port override.
PORT=
